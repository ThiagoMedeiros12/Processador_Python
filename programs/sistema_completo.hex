# ==============================================================================
# Programa de Demonstração Completa do Sistema (UniSantos - Organização de Comp)
# Cobre 100% dos Requisitos: LW, SW, CLZ, Loops, Branches, Terminal MMIO e VRAM
# ==============================================================================

# ------------------------------------------------------------------------------
# PARTE 1: Processamento em RAM com laço, LW, SW e instrução especial CLZ
# ------------------------------------------------------------------------------
20000513    # addi x10, x0, 512       (x10 = base de dados 0x200 na RAM)
00100593    # addi x11, x0, 1         (prepara valor de entrada)
00B52023    # sw   x11, 0(x10)       (armazena na RAM[0x200])
00200593    # addi x11, x0, 2         (prepara valor de entrada)
00B52223    # sw   x11, 4(x10)       (armazena na RAM[0x204])
00400593    # addi x11, x0, 4         (prepara valor de entrada)
00B52423    # sw   x11, 8(x10)       (armazena na RAM[0x208])
00800593    # addi x11, x0, 8         (prepara valor de entrada)
00B52623    # sw   x11, 12(x10)       (armazena na RAM[0x20C])

# Inicialização das variáveis do laço (for i=0; i<16; i+=4)
00000613    # addi x12, x0, 0         (x12 = offset_i = 0)
01000893    # addi x17, x0, 16        (x17 = limite = 16 bytes)

# LOOP_PROCESSAMENTO:
00C50733    # add  x14, x10, x12      (x14 = endereço atual de leitura)
00072783    # lw   x15, 0(x14)        (lê dado da RAM com LW)
60079813    # clz  x16, x15           (calcula zeros à esquerda com CLZ)
05072023    # sw   x16, 64(x14)       (salva resultado com SW em 0x240+offset)
00460613    # addi x12, x12, 4        (i += 4)
FF1616E3    # bne  x12, x17, -20      (salta se i != 16 para continuar laço)

# ------------------------------------------------------------------------------
# PARTE 2: Transmissão de Mensagem para o Terminal via Hardware MMIO (0x9FC04)
# ------------------------------------------------------------------------------
000A00B7    # lui  x1, 0xA0
C0008093    # addi x1, x1, -1024      (x1 = 0x9FC00 - base de E/S)
05B00113    # addi x2, x0, 91        (char '[')
00208223    # sb   x2, 4(x1)         (envia para registrador DATA_OUT)
