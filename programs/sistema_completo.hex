D2D20213    # addi x4, x4, -723     (palavra ASCII '---+')
0041A623    # sw   x4, 12(x3)        (grava 4 bytes via SW na VRAM)
4E552237    # lui  x4, 0x4E552
07C20213    # addi x4, x4, 124      (palavra ASCII '| UN')
