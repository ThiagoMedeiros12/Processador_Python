2D2D3237    # lui  x4, 0x2D2D3
D2B20213    # addi x4, x4, -725     (palavra ASCII '+---')
0241A823    # sw   x4, 48(x3)        (grava 4 bytes via SW na VRAM)
2D2D3237    # lui  x4, 0x2D2D3
D2D20213    # addi x4, x4, -723     (palavra ASCII '----')
0241AA23    # sw   x4, 52(x3)        (grava 4 bytes via SW na VRAM)
