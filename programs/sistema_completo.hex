# ------------------------------------------------------------------------------
# PARTE 3: Carga da VRAM (0x80000) usando STORE WORD (SW) - Seção 4 do Edital
# ------------------------------------------------------------------------------
000801B7    # lui  x3, 0x80           (x3 = 0x80000 - base da VRAM)
2D2D3237    # lui  x4, 0x2D2D3
D2B20213    # addi x4, x4, -725     (palavra ASCII '+---')
0041A023    # sw   x4, 0(x3)        (grava 4 bytes via SW na VRAM)
2D2D3237    # lui  x4, 0x2D2D3
D2D20213    # addi x4, x4, -723     (palavra ASCII '----')
0041A223    # sw   x4, 4(x3)        (grava 4 bytes via SW na VRAM)
2D2D3237    # lui  x4, 0x2D2D3
D2D20213    # addi x4, x4, -723     (palavra ASCII '----')
